## Server settings
# Server Address/Port
SERVER_HOST="0.0.0.0"
SERVER_PORT=3000

# Allow I/O to be logged into a .txt file
SERVER_LOG=true

# Enable command line
SERVER_ENABLE_CLI=true

# User limit (0 = unlimited)
SERVER_MAX_CONNECTIONS=0

# Max incoming WebSocket packet size (bytes)
SERVER_MAX_PAYLOAD=16384 #16 KB


# Timeout duration for the connection handshake (in milliseconds)
HANDSHAKE_TIMEOUT=10000


## Message settings
# Define max chat message length
MESSAGE_MAX_LENGTH=100

# Define limit of packets per second, this affects everything except handshakes (Chat, create/join/leave rooms, etc.)
RATE_LIMIT=5


## Chat rooms settings
# Enable chat rooms/Disable to have a single chat for everyone
ROOMS_ENABLED=true

# Max users per room (only used when rooms are enabled)
ROOMS_MAX_USERS=10